{
  "name": "synco",
  "version": "1.0.0",
  "description": "Plataforma de colaboração síncrona com videochamada P2P, mídia compartilhada e ferramentas de foco",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "test": "cd frontend && npm run test",
    "lint": "cd frontend && npm run lint",
    "format": "cd frontend && npm run format"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.synco.app",
    "productName": "Synco",
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
